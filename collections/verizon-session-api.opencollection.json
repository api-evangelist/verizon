{
  "opencollection": "1.0.0",
  "info": {
    "name": "Verizon ThingSpace Connectivity Management Accounts Session API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://thingspace.verizon.com/api/m2m/v2/session/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Session",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Verizon Login Session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://thingspace.verizon.com/api/m2m/v2/session/login",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Establishes an API session using a username and password. Returns an access token and session expiration time."
        }
      ]
    }
  ],
  "bundled": true
}